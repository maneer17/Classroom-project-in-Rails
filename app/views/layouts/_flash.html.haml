- flash_classes = { "notice" => "success", "alert" => "danger" }
.container.mt-3
  - flash.each do |flash_type, message|
    .alert.alert-dismissible.fade.show{class: "alert-#{flash_classes.fetch(flash_type.to_s, 'info')}", role: "alert"}
      = message
      %button.btn-close{type: "button", data: {"bs-dismiss": "alert"}, aria: {label: "Close"}}
