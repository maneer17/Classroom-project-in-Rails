:ruby
  active_devise = (current_teacher || current_student)
  navbar_class = active_devise.class == Teacher ? 'bg-dark navbar-dark' : active_devise.class == Student ? 'navbar-dark bg-primary':'navbar-dark bg-info'

%nav.navbar.navbar-expand-lg.shadow-sm{class: navbar_class}
  .container-fluid
    = link_to "Classroom", root_path, class: "navbar-brand"
    %button.navbar-toggler{type: "button", data: {"bs-toggle": "collapse", "bs-target": "#navbarNav"}, aria: {controls: "navbarNav", expanded: "false", label: "Toggle navigation"}}
      %span.navbar-toggler-icon
    #navbarNav.collapse.navbar-collapse
      %ul.navbar-nav.ms-auto
        - if active_devise
          = render "layouts/navbars/#{active_devise.class.name.underscore}"
        - else
          %li.nav-item
            = link_to t(".teacher_sign_in"), new_teacher_session_path, class: "nav-link"
          %li.nav-item
            = link_to t(".student_sign_in"), new_student_session_path, class: "nav-link"
