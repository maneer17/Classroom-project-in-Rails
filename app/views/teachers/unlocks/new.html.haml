.auth-page
  .auth-card.auth-card--teacher
    %h1.auth-card__title Resend unlock email
    = form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f|
      = render "teachers/shared/error_messages", resource: resource
      .mb-3
        = f.label :email, class: "form-label"
        = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control"
      = f.submit "Resend unlock instructions", class: "btn btn-primary btn-submit w-100"
    .auth-card__links= render "teachers/shared/links"
