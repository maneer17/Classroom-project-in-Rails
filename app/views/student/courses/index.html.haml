- content_for :title, t(".title")

.container.py-4
  %h1.h3.fw-bold.mb-4= t(".your_courses")

  .row.row-cols-1.row-cols-md-3.g-4
    - courses.each do |course|
      .col
        .card.course-card
          = render course

          .card-footer.bg-transparent.border-0.pt-0
            .d-flex.gap-2.mb-2
              = button_to t(".assignments"), student_course_assignments_path(course),
                            method: :get, class: "btn btn-primary btn-sm"
              = button_to t(".posts"), student_course_posts_path(course),
                            method: :get, class: "btn btn-primary btn-sm"

            = button_to t(".unenroll_from_course"), unenroll_student_courses_path(course_id: course.id),
                          method: :delete,
                          class: "btn btn-outline-danger btn-sm w-100",
                          data: { turbo_confirm: t(".turbo_confirm", course_name: course.name) }
