- content_for :title, t(".title")

= render "shared/page_header", title: t(".your_courses"), subtitle: "Jump into assignments and class posts", actions: link_to(t("layouts.navbars.student.enroll_in_new_courses"), new_courses_student_courses_path, class: "btn btn-outline-primary")

- if courses.any?
  .row.g-4#courses
    - courses.each do |course|
      .col-md-6.col-lg-4
        .card.course-card
          = render course
          .card-body.border-top
            .course-card__actions
              = link_to t(".assignments"), student_course_assignments_path(course), class: "btn btn-sm btn-primary"
              = link_to t(".posts"), student_course_posts_path(course), class: "btn btn-sm btn-outline-primary"
              = button_to t(".unenroll_from_course"), unenroll_student_courses_path(course_id: course.id), method: :delete, class: "btn btn-sm btn-outline-danger ms-auto", data: { turbo_confirm: t(".turbo_confirm", course_name: course.name) }
- else
  = render "shared/empty_state", icon: "collection", title: "No enrolled courses", message: "Browse the catalog and enroll to get started.", action: link_to("Enroll in courses", new_courses_student_courses_path, class: "btn btn-primary")
