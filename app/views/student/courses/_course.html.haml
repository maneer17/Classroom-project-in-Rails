%div{id: dom_id(course)}
  = render "attachment"
  .card-body
    %h3.course-card__title
      = link_to course.name, student_course_path(course), class: "text-decoration-none text-dark"
    %p.course-card__meta.text-truncate= truncate(course.description.to_s, length: 80)
    %p.course-card__meta.mb-0
      %i.bi.bi-person-workspace.me-1
      = Teacher.find(course.teacher_id).name
