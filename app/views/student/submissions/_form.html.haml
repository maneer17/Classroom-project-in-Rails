= form_with(model: [:student, course, assignment, submission], class: "vstack gap-3") do |form|
  - if submission.errors.any?
    .alert.alert-danger
      %h2.h6= submission.errors.count == 1 ? t("form.error_message.one", model: "submission") : t("form.error_message.other", count: submission.errors.count, model: "submission")
      %ul.mb-0
        - submission.errors.full_messages.each do |error|
          %li= error

  .mb-0
    = form.label :title, class: "form-label"
    = form.text_field :title, class: "form-control"
  .mb-0
    = form.label :file, class: "form-label"
    = form.file_field :file, class: "form-control"
    = form.hidden_field :assignment_id, value: assignment.id

  = form.submit class: "btn btn-primary"
