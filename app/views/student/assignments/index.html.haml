- content_for :title, "Homework"

= render "shared/page_header", title: "Homework", subtitle: "Assignments for this class"

- if assignments.any?
  .data-table-wrap#assignments
    %table.table.table-hover.align-middle.mb-0
      %thead
        %tr
          %th= t(".assignment")
          %th= t(".deadline")
      %tbody
        - assignments.each do |assignment|
          %tr
            %td= link_to assignment.title, student_course_assignment_path(course, assignment), class: "fw-semibold text-decoration-none"
            %td.text-muted= assignment.deadline&.strftime("%B %d, %Y %I:%M %p")
- else
  = render "shared/empty_state", icon: "clipboard", title: "No assignments", message: "Your teacher hasn't posted assignments for this course yet."

.mt-3= link_to t(".back_to_course"), student_course_path(course), class: "btn btn-link"
