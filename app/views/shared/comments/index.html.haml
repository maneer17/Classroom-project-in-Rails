.comment-thread.mt-4
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
    %h3.comment-thread__title.mb-0 Discussion
    = link_to "Leave a comment", new_path, class: "btn btn-sm btn-outline-primary", data: { turbo_frame: dom_id(Comment.new) }

  = turbo_frame_tag dom_id(Comment.new)

  #comments.vstack
    = render partial: "shared/comments/comment", collection: comments, locals: { role: role, course: local_assigns[:course], post: local_assigns[:post] }
