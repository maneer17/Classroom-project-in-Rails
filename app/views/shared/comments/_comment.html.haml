= turbo_frame_tag dom_id(comment) do
  .comment-item
    %p.comment-item__body= comment.body
    %span.comment-item__author
      %i.bi.bi-person-circle.me-1
      = comment.commenter&.name

    - if current_student == comment.commenter || current_teacher == comment.commenter
      - if comment.persisted?
        .comment-item__actions
          = link_to (role == :student ? edit_student_course_post_comment_path(course, post, comment) : edit_teacher_course_post_comment_path(course, post, comment)), class: "btn btn-link btn-sm p-0" do
            %i.bi.bi-pencil.me-1
            Edit
          = button_to [role, course, post, comment], method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-link btn-sm p-0 text-danger" do
            %i.bi.bi-trash.me-1
            Delete
