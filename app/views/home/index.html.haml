- content_for :title, "Welcome"

.landing-hero
  %h1.landing-hero__title Your classroom, calm and clear
  %p.landing-hero__lead
    Courses, assignments, and discussions in one cozy place.
    Sign in as a student or teacher to get started.

  .landing-cards
    .landing-card
      .landing-card__icon 🎓
      %h2.landing-card__title Student
      %p.landing-card__text Enroll in courses, submit work, and track your progress.
      = link_to "Sign in as student", new_student_session_path, class: "btn btn-primary w-100"
      .text-center.mt-2
        %small.text-muted
          New here?
          = link_to "Create account", new_student_registration_path

    .landing-card
      .landing-card__icon 📚
      %h2.landing-card__title Teacher
      %p.landing-card__text Create courses, post assignments, and review submissions.
      = link_to "Sign in as teacher", new_teacher_session_path, class: "btn btn-outline-primary w-100"
      .text-center.mt-2
        %small.text-muted
          New here?
          = link_to "Create account", new_teacher_registration_path
