- content_for :title, "Classroom"

.entrance
  %p.entrance__kicker Classroom
  %h1.entrance__title Take your seat
  %p.entrance__lead
    Students and teachers use different doors.
    Sign in to open your classes.

  .door-row
    .door.door--student
      %span.door__label Student
      %h2.door__title Your classes are inside
      %p.door__text Homework, the class board, and your progress each have their own page.
      = link_to "Sign in", new_student_session_path, class: "btn btn-primary"
      %p.door__alt
        New here?
        = link_to "Create a student account", new_student_registration_path

    .door.door--teacher
      %span.door__label Teacher
      %h2.door__title Your classes are inside
      %p.door__text Open a class, then use the board and homework pages separately.
      = link_to "Sign in", new_teacher_session_path, class: "btn btn-outline-primary"
      %p.door__alt
        New here?
        = link_to "Create a teacher account", new_teacher_registration_path
