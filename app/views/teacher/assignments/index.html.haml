- content_for :title, "Homework"

= render "shared/page_header", title: "Homework", subtitle: "Assignments for this class", actions: link_to("New assignment", new_teacher_course_assignment_path, class: "btn btn-success")

- if assignments.any?
  .data-table-wrap#assignments
    %table.table.table-hover.align-middle.mb-0
      %thead
        %tr
          %th{scope: "col"}= t(".assignment")
          %th{scope: "col"}= t(".deadline")
      %tbody
        - assignments.each do |assignment|
          %tr
            %td= link_to assignment.title, [:teacher, course, assignment], class: "fw-semibold text-decoration-none"
            %td.text-muted
              - if assignment.deadline
                = assignment.deadline.strftime("%B %d, %Y %I:%M %p")
              - else
                —
- else
  = render "shared/empty_state", icon: "clipboard-check", title: "No assignments", message: "Create an assignment for this course.", action: link_to(t(".new_assignment"), new_teacher_course_assignment_path, class: "btn btn-primary")
