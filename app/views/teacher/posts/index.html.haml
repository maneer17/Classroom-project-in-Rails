- content_for :title, "Board"

= render "shared/page_header", title: "Board", subtitle: "Announcements for this class", actions: link_to("New post", new_teacher_course_post_path, class: "btn btn-success")

- if posts.any?
  .vstack.gap-3
    - posts.each do |post|
      .card
        .card-body
          %h3.h5.card-title= link_to post.title, teacher_course_post_path(course, post), class: "text-decoration-none"
          %p.card-text.text-muted.mb-3= truncate(post.body, length: 200)
          .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
            %span.badge.badge-soft.rounded-pill
              - count = post.comments.count
              - if count == 0
                = t(".comments.zero")
              - elsif count == 1
                = t(".comments.one")
              - else
                = t(".comments.other", count: count)
            = link_to t(".view_post"), teacher_course_post_path(course, post), class: "btn btn-sm btn-outline-primary"
- else
  = render "shared/empty_state", icon: "chat-square-text", title: "No posts yet", message: "Share updates with your class.", action: link_to(t(".new_post"), new_teacher_course_post_path, class: "btn btn-primary")
