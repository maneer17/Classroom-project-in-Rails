= turbo_stream_from post

= render "shared/page_header", title: post.title

.detail-card
  .post-body= post.body

  .d-flex.flex-wrap.gap-2.mt-3
    = link_to t("edit"), edit_teacher_course_post_path(course, post), class: "btn btn-outline-primary btn-sm"
    = link_to t(".back_to_posts"), teacher_course_posts_path(course), class: "btn btn-link btn-sm"
    = button_to t("delete"), [:teacher, course, post], method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Are you sure?" }

= render template: "shared/comments/index", locals: { comments: post.comments, role: :teacher, new_path: new_teacher_course_post_comment_path(course, post), course: course, post: post }
