= form_with model: [:teacher, course, post], local: true, class: "vstack gap-3" do |form|
  - if post.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - post.errors.full_messages.each do |message|
          %li= message

  .mb-0
    = form.label :title, class: "form-label"
    = form.text_field :title, class: "form-control", placeholder: "Enter post title"

  .mb-0
    = form.label :body, class: "form-label"
    = form.text_area :body, class: "form-control", rows: 10, placeholder: "Write your post here..."

  .d-flex.flex-wrap.gap-2
    = form.submit "Save", class: "btn btn-primary"
    = link_to "Back to posts", teacher_course_posts_path(course), class: "btn btn-link"
