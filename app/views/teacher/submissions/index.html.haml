- content_for :title, "Submissions"

= render "shared/page_header", title: "Submissions", subtitle: "#{assignment.title} · #{submissions.count} submitted"

- if submissions.any?
  .data-table-wrap#submissions
    %table.table.table-hover.align-middle.mb-0
      %thead
        %tr
          %th Student
          %th Title
          %th File
          %th Submitted
      %tbody
        - submissions.each do |submission|
          %tr
            %td= Student.find(submission.student_id).name
            %td= link_to submission.title, teacher_course_assignment_submission_path(course, assignment, submission), class: "text-decoration-none fw-semibold"
            %td= render "attachment", submission: submission
            %td.text-muted= submission.created_at.strftime("%b %d, %Y %I:%M %p")
- else
  = render "shared/empty_state", icon: "inbox", title: "No submissions yet", message: "Students haven't submitted work for this assignment."

.mt-3
  = link_to t(".back_to_assignment"), teacher_course_assignment_path(course, assignment), class: "btn btn-link"
