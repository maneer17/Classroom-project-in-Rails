= render "shared/page_header", title: course.name, subtitle: course.description

.detail-card
  .d-flex.flex-wrap.gap-2.mb-3
    %span.badge.badge-soft.rounded-pill
      %i.bi.bi-people.me-1
      = "#{course.students.count} #{t('.enrolled_in_this_course')}"

  .d-flex.flex-wrap.gap-2
    = link_to t("edit"), edit_teacher_course_path(course), class: "btn btn-warning"
    = button_to t("delete"), [:teacher, course], method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: t(".are_you_sure", default: "Are you sure you want to delete this course?") }
    = link_to t("teacher.courses.course.back_to_courses"), teacher_courses_path, class: "btn btn-link"
