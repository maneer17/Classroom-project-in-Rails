- content_for :title, "My classes"

= render "shared/page_header", title: "Hello, #{current_teacher.name.presence || "there"}", subtitle: "Open a class to reach its board and homework.", actions: link_to("New class", new_teacher_course_path, class: "btn btn-success")

- if courses.any?
  .row.g-4#courses
    - courses.each do |course|
      .col-md-6.col-lg-4
        = render course
- else
  = render "shared/empty_state", icon: "journal-bookmark", title: "No classes yet", message: "Create your first class, then post on the board and assign homework.", action: link_to("New class", new_teacher_course_path, class: "btn btn-primary")
