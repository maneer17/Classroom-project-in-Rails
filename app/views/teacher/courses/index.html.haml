- content_for :title, t(".title")

= render "shared/page_header", title: t(".title"), subtitle: "Manage your teaching spaces", actions: link_to(t("layouts.navbars.teacher.new_course"), new_teacher_course_path, class: "btn btn-success")

- if courses.any?
  .row.g-4#courses
    - courses.each do |course|
      .col-md-6.col-lg-4
        = render course
- else
  = render "shared/empty_state", icon: "journal-bookmark", title: "No courses yet", message: "Create your first course to start posting assignments.", action: link_to("New course", new_teacher_course_path, class: "btn btn-primary")
