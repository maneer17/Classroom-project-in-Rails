.auth-page
  .auth-card
    %h1.auth-card__title Forgot your password?
    %p.auth-card__subtitle We'll email you reset instructions

    = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
      = render "students/shared/error_messages", resource: resource
      .mb-3
        = f.label :email, class: "form-label"
        = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control"
      = f.submit "Send reset instructions", class: "btn btn-primary btn-submit w-100"

    .auth-card__links
      = render "students/shared/links"
