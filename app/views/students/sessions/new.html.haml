.auth-page
  .auth-card
    %img.auth-card__icon{alt: "Student", src: "https://www.svgrepo.com/show/493587/female-student-studying.svg"}/
    %h1.auth-card__title Welcome back
    %p.auth-card__subtitle Sign in to your student account

    = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f|
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control mb-3", placeholder: "Email"
      = f.password_field :password, autocomplete: "current-password", class: "form-control mb-3", placeholder: "Password"

      - if devise_mapping.rememberable?
        .form-check.mb-3
          = f.check_box :remember_me, class: "form-check-input"
          = f.label :remember_me, class: "form-check-label"

      = f.submit "Log in", class: "btn btn-primary btn-submit"

    .auth-card__links
      = render "students/shared/links"
      .mb-1= link_to "Teacher sign in", new_teacher_session_path
      .mb-1= link_to "Back to the entrance", root_path
